{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "foreground": "#45F1C2",
          "style": "plain",
          "template": "\uf508 {{ .UserName }} <#a6a6a6>on</>",
          "type": "session"
        },
        {
          "foreground": "#0CA0D8",
          "properties": {
            "folder_separator_icon": "/",
            "style": "full"
          },
          "style": "plain",
          "template": " \uf07b {{ .Path }} ",
          "type": "path"
        },
        {
          "foreground": "#e2970c",
          "properties": {
            "branch_icon": "\ue725 ",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "plain",
          "template": "{{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} <#a6a6a6>{{ .BranchStatus }}</>{{ end }}{{ if .Working.Changed }} <#F38BA8>\uf044 {{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }} <#A6E3A1>\uf046 {{ .Staging.String }}</>{{ end }}{{ if gt .StashCount 0 }} <#CBA6F7>\uf692 {{ .StashCount }}</>{{ end }} ",
          "type": "git"
        },
        {
          "type": "dotnet",
          "style": "plain",
          "foreground": "#512BD4",
          "template": "\ue77f {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#6CC24A",
          "template": "\ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} "
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#FFE873",
          "template": "\ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "foreground": "#CBA6F7",
          "properties": {
            "threshold": 200
          },
          "style": "plain",
          "template": "\uf520 {{ .FormattedMs }}",
          "type": "executiontime"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#cd5e42",
          "style": "plain",
          "template": "\ue3bf ",
          "type": "root"
        },
        {
          "foreground": "#A6E3A1",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#F38BA8{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "❯ ",
          "type": "exit"
        }
      ]
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#A6E3A1",
    "template": "❯ "
  },
  "version": 3
}
